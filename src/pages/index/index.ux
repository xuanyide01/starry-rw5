<template>
  <div class="page" onswipe="swipe">
    <image if="{{mode === 'title' || mode === 'end'}}" class="screen-art" src="/common/ui/title.jpg"></image>
    <image if="{{mode !== 'title' && mode !== 'play' && mode !== 'choice' && mode !== 'cg' && mode !== 'end'}}" class="screen-art" src="/common/ui/panel.jpg"></image>
    <div if="{{mode === 'play' || mode === 'choice'}}" class="art" onclick="advance">
      <image class="background" src="{{backgroundSrc}}" onerror="backgroundError" oncomplete="backgroundLoaded"></image>
      <image if="{{bodySrc !== ''}}" class="body" style="left: {{bodyLeft}}px; top: {{bodyTop}}px; width: {{bodyWidth}}px; height: {{bodyHeight}}px;" src="{{bodySrc}}"></image>
    </div>
    <div if="{{mode === 'title'}}" class="title-panel">
      <div class="title-action" onclick="startNew"><image class="title-button" src="/common/ui/title_01start_on.png"></image></div>
      <div class="title-action" onclick="continueGame"><image class="title-button" src="/common/ui/title_02load_on.png"></image></div>
      <div class="title-action" onclick="openConfig"><image class="title-button" src="/common/ui/title_03config_on.png"></image></div>
      <div class="title-action" onclick="openGallery"><image class="title-button" src="/common/ui/title_04gallery_on.png"></image></div>
    </div>
    <div if="{{mode === 'play'}}" class="dialogue-panel">
      <image class="dialogue-skin" src="/common/ui/dialogue.png"></image>
      <div class="speaker-row"><div if="{{speaker !== ''}}" class="nameplate"><image class="name-skin" src="/common/ui/window_name.png"></image><text class="speaker">{{speaker}}</text></div></div>
      <scroll id="dialogue-scroll" class="dialogue-scroll" scroll-y="true" onclick="dialogueTap" ontouchstart="dialogueTouchStart" ontouchmove="dialogueTouchMove" ontouchend="dialogueTouchEnd" ontouchcancel="dialogueTouchEnd" onscroll="dialogueScrolled"><text class="dialogue" style="font-size: {{fontSize}}px;">{{displayText}}</text></scroll>
      <div class="toolbar"><text class="tool" onclick="goBack">‹ 上一句</text><text class="tool menu-tool" onclick="showMenu">菜单</text><text class="tool" onclick="advance">下一句 ›</text></div>
    </div>
    <div if="{{mode === 'choice'}}" class="choice-panel">
      <image class="dialogue-skin" src="/common/ui/dialogue.png"></image><text class="choice-title">请选择</text>
      <text for="{{options}}" tid="text" class="choice" onclick="pick($idx)">{{$item.text}}</text>
      <text class="small-action" onclick="showMenu">旅行菜单</text>
    </div>
    <div if="{{mode === 'menu'}}" class="overlay menu-panel">
      <text class="menu-title">旅行菜单</text>
      <text class="menu-action" onclick="saveGame">保存进度</text>
      <text class="menu-action" onclick="loadGame">读取进度</text>
      <text class="menu-action" style="color: {{hasNextChapter ? '#f5f7ff' : '#abb9ca'}};" onclick="goNextChapter">下一章 ›</text>
      <text class="menu-action" onclick="toggleAuto">{{autoLabel}}</text>
      <text class="menu-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text>
      <text class="menu-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="menu-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="menu-action" onclick="resume">返回游戏</text>
      <text class="menu-action" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'config'}}" class="overlay config-panel">
      <text class="panel-title">旅行设定</text><text class="panel-subtitle">CONFIG</text>
      <text class="config-action" onclick="cycleAutoSpeed">{{autoSpeedLabel}}</text>
      <text class="config-action" onclick="toggleSpeed">{{speedLabel}}</text>
      <text class="config-action" onclick="toggleFont">{{fontLabel}}</text>
      <text class="config-note">自动播放可在阅读菜单开启。逐字显示完成后稍等，继续下一句。遇到选项暂停，选择后自动继续。</text>
      <text class="config-action config-back" onclick="toTitle">返回标题</text>
    </div>
    <div if="{{mode === 'slots'}}" class="full-panel">
      <text class="panel-title">{{slotTitle}}</text><text class="panel-subtitle">{{slotPageLabel}}</text>
      <div class="slot-list"><div for="{{slotRows}}" tid="number" class="slot-card" onclick="selectSlot($item.index)"><image class="slot-skin" src="/common/ui/slot.png"></image><text class="slot-title">{{$item.title}}</text><text class="slot-meta">{{$item.meta}}</text><text class="slot-preview">{{$item.preview}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousSlotPage">‹ 上一页</text><text class="pager-action" onclick="closeSlots">返回</text><text class="pager-action" onclick="nextSlotPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'overwrite'}}" class="overlay confirm-panel">
      <text class="menu-title">{{overwriteTitle}}</text><text class="confirm-text">{{overwriteDetail}}</text>
      <text class="config-action" onclick="confirmOverwrite">确认覆盖</text><text class="config-action" onclick="cancelOverwrite">取消</text>
    </div>
    <div if="{{mode === 'gallery'}}" class="full-panel">
      <text class="panel-title">CG 鉴赏</text><text class="panel-subtitle">{{galleryPageLabel}}</text>
      <div class="gallery-row"><div for="{{galleryTop}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text></div></div>
      <div class="gallery-row"><div for="{{galleryBottom}}" tid="image" class="gallery-card" onclick="viewCg($item.index)"><image class="gallery-thumb" src="{{$item.src}}"></image><text class="gallery-caption">{{$item.label}}</text></div></div>
      <div class="pager"><text class="pager-action" onclick="previousGalleryPage">‹ 上一页</text><text class="pager-action" onclick="toTitle">返回标题</text><text class="pager-action" onclick="nextGalleryPage">下一页 ›</text></div>
    </div>
    <div if="{{mode === 'cg'}}" class="cg-panel">
      <image class="cg-image" src="{{cgSrc}}" onclick="cycleCg"></image><text class="cg-caption">{{cgLabel}}</text>
      <div class="cg-controls"><text class="pager-action cg-link" onclick="previousCg">‹ 上一组</text><text class="pager-action cg-link" onclick="backToGallery">返回列表</text><text class="pager-action cg-link" onclick="nextCg">下一组 ›</text></div>
    </div>
    <div if="{{mode === 'end'}}" class="end-panel"><text class="game-title">旅行的终点</text><text class="subtitle">感谢陪伴</text><text class="config-action" onclick="toTitle">返回标题</text></div>
    <div if="{{mode === 'error'}}" class="overlay confirm-panel"><text class="menu-title">暂时无法继续</text><text class="error-text">{{errorText}}</text><text class="config-action" onclick="toTitle">返回标题</text></div>
    <text if="{{loading}}" class="loading">加载中…</text>
  </div>
</template>
<script>
import file from '@system.file';
import storage from '@system.storage';
import prompt from '@system.prompt';
import {newState,restore,readFrame,readChapterSkip,next,nextChapter,choose,previous} from '../../common/engine.js';
import {SLOT_COUNT,LEGACY_KEY,slotKey,decodeSave,createSave,slotRow} from '../../common/saves.js';
import {imagePath} from '../../common/assets.js';
import {portraitRect} from '../../common/portrait-layout.js';
import {groupGallery,stepVariant} from '../../common/gallery.js';
import {autoSpeeds,autoWait} from '../../common/auto-reader.js';
import {normalizeText} from '../../common/text-format.js';
export default {
  private:{mode:'title',backgroundSrc:'/common/images/title_bg.png',bodySrc:'',bodyLeft:0,bodyTop:0,bodyWidth:432,bodyHeight:286,speaker:'',displayText:'',chapterLabel:'',
    options:[],loading:false,errorText:'',hasNextChapter:true,autoEnabled:false,autoSpeed:1,autoLabel:'自动播放：关闭',autoSpeedLabel:'自动速度：标准',fontSize:24,textSpeed:30,speedLabel:'显示速度：逐字',fontLabel:'字号：标准',
    slotTitle:'',slotPage:0,slotPageLabel:'',slotRows:[],storageBusy:false,overwriteTitle:'',overwriteDetail:'',
    galleryPage:0,galleryPageLabel:'',galleryTop:[],galleryBottom:[],cgIndex:0,cgVariant:0,cgSrc:'',cgLabel:''},
  onInit(){
    this.session=newState();this.cachedChapter=0;this.ops=[];this.loadSequence=0;this.timer=null;this.fullText='';this.resumeMode='play';this.autoEnabled=false;this._alive=true;this._hidden=false;this._pendingFrame=false;this._autoTimer=null;this._autoGeneration=0;this._typingGeneration=0;this._touchReading=false;
    this._slotsSequence=0;this._gallerySequence=0;this._slotData=[];this._galleryCatalog=[];this._galleryTotal=0;this._slotsReturnMode='title';this._slotRole='load';
    storage.get({complete:()=>{},key:'starry_rw5_settings_v1',success:data=>{try{const s=JSON.parse(data);this.fontSize=s.fontSize===28?28:24;this.textSpeed=s.textSpeed===0?0:30;this.autoSpeed=s.autoSpeed===0||s.autoSpeed===2?s.autoSpeed:1;this.refreshSettings();}catch(e){}},fail:()=>{}});
    console.log('STARRY_RW5 title ready');
  },
  backgroundLoaded(){console.log('STARRY_RW5 background loaded',this.mode,this.backgroundSrc);},
  backgroundError(){console.log('STARRY_RW5 background failed',this.mode,this.backgroundSrc);},
  clearTyping(){this.clearAuto();this._typingGeneration++;if(this.timer!==null){clearTimeout(this.timer);this.timer=null;}},
  clearAuto(){if(this._autoTimer!=null)clearTimeout(this._autoTimer);this._autoTimer=null;this._autoGeneration=(this._autoGeneration||0)+1;},
  canAuto(){return this.autoEnabled&&this._alive&&!this._hidden&&!this._touchReading&&!this.loading&&!this.storageBusy&&this.mode==='play'&&this.timer===null&&this.displayText===this.fullText;},
  armAuto(){
    this.clearAuto();if(!this.canAuto())return;
    const generation=this._autoGeneration,chapter=this.session.chapter,cursor=this.session.cursor;
    this._autoTimer=setTimeout(()=>{if(generation!==this._autoGeneration)return;this._autoTimer=null;if(!this.canAuto()||this.session.chapter!==chapter||this.session.cursor!==cursor)return;console.log('STARRY_RW5 auto advance',chapter,cursor);this.advance();},autoWait(this.autoSpeed,this.fullText.length));
  },
  stopAuto(){this.autoEnabled=false;this.clearAuto();this.refreshSettings();},
  toggleAuto(){if(this.mode!=='menu')return;this.autoEnabled=!this.autoEnabled;this.clearAuto();this.refreshSettings();console.log('STARRY_RW5 auto enabled',this.autoEnabled);},
  cycleAutoSpeed(){if(this.mode!=='menu'&&this.mode!=='config')return;this.autoSpeed=(this.autoSpeed+1)%3;this.refreshSettings();this.persistSettings();console.log('STARRY_RW5 auto speed',this.autoSpeed);},

  onShow(){this._hidden=false;if(this._pendingFrame||(this._chapterSkip&&this.timer===null))this.renderFrame();else this.armAuto();},
    onHide(){this._hidden=true;this._touchReading=false;this.clearTyping();if(!this._chapterSkip&&this.mode==='play')this.displayText=this.fullText;},
  onDestroy(){this._alive=false;this.stopAuto();this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;},
  startNew(){if(this.loading||this.mode!=='title')return;this.stopAuto();this.clearTyping();this._chapterSkip=null;this.session=newState();this.cachedChapter=0;this.renderFrame();},
  continueGame(){if(this.mode==='title')this.openSlots('load');},
  openConfig(){if(this.loading||this.mode!=='title')return;this.clearTyping();this.mode='config';console.log('STARRY_RW5 config');},
  readChapter(chapter,done){
    if(this.cachedChapter===chapter){done();return;}
    this.loading=true;const seq=++this.loadSequence;
    file.readText({complete:()=>{},uri:'/common/story/'+chapter+'.txt',success:data=>{
      if(seq!==this.loadSequence)return;
      try{const ops=JSON.parse(data.text);if(!Array.isArray(ops))throw new Error('章节格式无效');this.ops=ops;this.cachedChapter=chapter;this.loading=!!this._chapterSkip;done();}
      catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this.loadSequence)this.fail('第 '+chapter+' 章读取失败：'+code+' '+String(data||'').slice(0,100));}});
  },
  renderFrame(){
    this._pendingFrame=true;this.clearTyping();this.readChapter(this.session.chapter,()=>{
      if(this._hidden)return;
      try{
        const f=this._chapterSkip?readChapterSkip(this.ops,this.session,this._chapterSkip):readFrame(this.ops,this.session);
        if(f.type==='jump'){this.session.chapter=f.to[0];this.session.cursor=f.to[1];this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);return;}if(f.type==='yield'){this.timer=setTimeout(()=>{this.timer=null;this.renderFrame();},0);return;}this._chapterSkip=null;this._pendingFrame=false;this.loading=false;
        this.backgroundSrc=imagePath(this.session.background);
        this.bodySrc=this.session.body?imagePath(this.session.body):'';
        const rect=portraitRect(this.session.body);this.bodyLeft=rect[0];this.bodyTop=rect[1];this.bodyWidth=rect[2];this.bodyHeight=rect[3];
        this.chapterLabel=this.session.chapter+' / 17';this.hasNextChapter=!this.session.ended;
        if(f.type==='choice'){this.options=f.items.map(item=>Object.assign({},item,{text:normalizeText(item.text)}));this.mode='choice';console.log('STARRY_RW5 choice',this.session.chapter,this.session.cursor);return;}
        if(f.type==='end'){this.stopAuto();this.mode='end';console.log('STARRY_RW5 ending');return;}
        this.mode='play';this.speaker=normalizeText(f.speaker);this.fullText=normalizeText(f.text);this.displayText='';this._dialogueDragged=false;this._dialogueIgnoreUntil=0;
        try{this.$element('dialogue-scroll').scrollTo({top:0});}catch(e){}
        console.log('STARRY_RW5 frame',this.session.chapter,this.session.cursor);
        const speed=this.autoEnabled?30:this.textSpeed,generation=this._typingGeneration;
        if(speed===0){this.displayText=this.fullText;this.armAuto();return;}
        const tick=()=>{if(!this._alive||this._hidden||this.mode!=='play'||generation!==this._typingGeneration)return;this.displayText=this.fullText.slice(0,this.displayText.length+1);if(this.displayText.length<this.fullText.length)this.timer=setTimeout(tick,speed);else{this.timer=null;this.armAuto();}};tick();
      }catch(e){this.fail(e.message);}
    });
  },
  advance(){if(this.loading||this.mode!=='play')return;this.clearAuto();if(this.timer!==null){this.clearTyping();this.displayText=this.fullText;this.armAuto();return;}next(this.session);this.renderFrame();},
  dialoguePoint(event){const t=event&&((event.touches&&event.touches[0])||(event.changedTouches&&event.changedTouches[0]));return t?{x:Number(t.clientX===undefined?t.pageX:t.clientX),y:Number(t.clientY===undefined?t.pageY:t.clientY)}:null;},
  dialogueTouchStart(event){this._touchReading=true;this.clearAuto();this._dialogueTouch=this.dialoguePoint(event);this._dialogueDragged=false;},
  dialogueTouchMove(event){const p=this.dialoguePoint(event),start=this._dialogueTouch;if(p&&start&&(Math.abs(p.x-start.x)>8||Math.abs(p.y-start.y)>8))this._dialogueDragged=true;},
  dialogueTouchEnd(){if(this._dialogueDragged)this._dialogueIgnoreUntil=Date.now()+450;this._dialogueTouch=null;this._touchReading=false;this.armAuto();},
  dialogueScrolled(){if(this._dialogueTouch){this._dialogueDragged=true;this._dialogueIgnoreUntil=Date.now()+450;}if(this.mode==='play')this.armAuto();},
  dialogueTap(){if(this._dialogueDragged||Date.now()<(this._dialogueIgnoreUntil||0)){this._dialogueDragged=false;return;}this.advance();},
  goNextChapter(){if(this.loading||this.mode!=='menu')return;if(this.resumeMode==='choice'){this.mode='choice';this.toast('请先作出当前选择');return;}this.clearTyping();this._chapterSkip=nextChapter(this.session);if(!this._chapterSkip){this.toast('本篇已结束');return;}this._autoHops=0;this.loading=true;this.renderFrame();console.log('STARRY_RW5 safe chapter skip',this.session.chapter,this.session.cursor);},
  pick(index){if(this.mode!=='choice'||this.loading)return;choose(this.session,this.options[index],index);this.renderFrame();},
  goBack(){if(this.loading||this.mode!=='play')return;this.stopAuto();this.clearTyping();if(previous(this.session))this.renderFrame();else this.toast('已经是第一句');},
  showMenu(){if(this.loading||(this.mode!=='play'&&this.mode!=='choice'))return;this.clearTyping();this.displayText=this.fullText;this.resumeMode=this.mode;this.mode='menu';console.log('STARRY_RW5 menu',this.session.chapter);},
  resume(){if(this.mode!=='menu')return;this.mode=this.resumeMode;this.armAuto();},
  swipe(event){
    if(event.direction==='right'&&this.mode==='config'){this.toTitle();return;}
    if(this.mode==='gallery'){if(event.direction==='left')this.nextGalleryPage();if(event.direction==='right')this.previousGalleryPage();return;}
    if(event.direction==='right'&&(this.mode==='play'||this.mode==='choice'))this.showMenu();
  },
  saveGame(){this.openSlots('save');},
  loadGame(){this.openSlots('load');},
  openSlots(role){
    if(this.loading||this.storageBusy)return;this.clearTyping();this._slotsReturnMode=this.mode;this._slotRole=role;
    this._pendingSave=role==='save'?createSave(this.session,this.resumeMode,Date.now()):null;
    this.slotTitle=role==='save'?'选择保存栏位':'选择读取栏位';this.slotPage=0;this.slotRows=[];this.mode='slots';this.loading=true;
    const seq=++this._slotsSequence;this._slotData=Array(SLOT_COUNT).fill(null);let remaining=SLOT_COUNT;
    const ready=()=>{if(seq!==this._slotsSequence)return;this.loading=false;this.refreshSlotRows();console.log('STARRY_RW5 slots ready',role);};
    const finish=()=>{
      if(seq!==this._slotsSequence||--remaining!==0)return;
      if(this._slotData[0]){ready();return;}
      storage.get({complete:()=>{},key:LEGACY_KEY,default:'',success:data=>{if(seq!==this._slotsSequence)return;try{const old=decodeSave(data);if(old){old.legacy=true;this._slotData[0]=old;}}catch(e){}ready();},fail:ready});
    };
    for(let i=0;i<SLOT_COUNT;i++)storage.get({complete:()=>{},key:slotKey(i),default:'',success:data=>{if(seq!==this._slotsSequence)return;try{this._slotData[i]=decodeSave(data);}catch(e){this._slotData[i]={invalid:true};}finish();},fail:()=>{if(seq!==this._slotsSequence)return;this._slotData[i]={invalid:true};finish();}});
  },
  refreshSlotRows(){const start=this.slotPage*4;const rows=[];for(let i=start;i<Math.min(start+4,SLOT_COUNT);i++)rows.push(slotRow(i,this._slotData[i]));this.slotRows=rows.map(row=>Object.assign({},row,{title:normalizeText(row.title),meta:normalizeText(row.meta),preview:normalizeText(row.preview)}));this.slotPageLabel=SLOT_COUNT+' 个栏位 · 第 '+(this.slotPage+1)+' / '+Math.ceil(SLOT_COUNT/4)+' 页';},
  previousSlotPage(){if(this.loading||this.slotPage===0)return;this.slotPage--;this.refreshSlotRows();},
  nextSlotPage(){if(this.loading||this.slotPage>=Math.ceil(SLOT_COUNT/4)-1)return;this.slotPage++;this.refreshSlotRows();},
  closeSlots(){if(this.storageBusy)return;this._slotsSequence++;this.loading=false;this.mode=this._slotsReturnMode;this.armAuto();},
  selectSlot(index){
    if(this.loading||this.storageBusy||this.mode!=='slots'||index<0||index>=SLOT_COUNT)return;
    const saved=this._slotData[index];
    if(this._slotRole==='load'){
      if(!saved){this.toast('这个栏位还没有存档');return;}if(saved.invalid){this.toast('这个存档无法读取');return;}
      try{this.session=restore(saved.state);this.cachedChapter=0;this._slotsSequence++;this.renderFrame();console.log('STARRY_RW5 slot loaded',index+1,this.session.chapter,this.session.cursor);}catch(e){this.toast(e.message);}return;
    }
    this._pendingSlotIndex=index;
    if(saved){const row=slotRow(index,saved);this.overwriteTitle='覆盖'+row.title+'？';this.overwriteDetail=row.meta+'\n覆盖后将保存当前进度。';this.mode='overwrite';console.log('STARRY_RW5 overwrite',index+1);return;}
    this.commitSlot();
  },
  confirmOverwrite(){if(this.mode==='overwrite')this.commitSlot();},
  cancelOverwrite(){if(!this.storageBusy)this.mode='slots';},
  commitSlot(){
    if(this.storageBusy||!this._pendingSave)return;
    const index=this._pendingSlotIndex,seq=this._slotsSequence,payload=this._pendingSave;payload.savedAt=Date.now();this.storageBusy=true;this.loading=true;
    storage.set({complete:()=>{},key:slotKey(index),value:JSON.stringify(payload),success:()=>{
      if(seq!==this._slotsSequence)return;this._slotData[index]=payload;this.storageBusy=false;this.loading=false;this._slotsSequence++;this.mode=this.resumeMode;this.armAuto();
      this.toast('已保存到存档 '+('0'+(index+1)).slice(-2));console.log('STARRY_RW5 slot saved',index+1,payload.state.chapter,payload.state.cursor);
    },fail:()=>{if(seq!==this._slotsSequence)return;this.storageBusy=false;this.loading=false;this.toast('保存失败，请重试');}});
  },
  openGallery(){
    if(this.loading||this.mode!=='title')return;this.clearTyping();this.mode='gallery';
    if(this._galleryCatalog.length){this.refreshGallery();return;}
    this.loading=true;const seq=++this._gallerySequence;
    file.readText({complete:()=>{},uri:'/common/gallery.txt',success:data=>{
      if(seq!==this._gallerySequence)return;
      try{const items=JSON.parse(data.text);if(!Array.isArray(items)||!items.length)throw new Error('CG 目录为空');this._galleryCatalog=groupGallery(items);this._galleryTotal=items.length;this.galleryPage=0;this.loading=false;this.refreshGallery();console.log('STARRY_RW5 gallery ready',this._galleryCatalog.length,items.length);}catch(e){this.fail(e.message);}
    },fail:(data,code)=>{if(seq===this._gallerySequence)this.fail('CG 目录读取失败：'+code);}});
  },
  refreshGallery(){const start=this.galleryPage*4;const items=this._galleryCatalog.slice(start,start+4).map((item,i)=>({image:item.image,label:item.label+'\n'+item.variants.length+' 张',index:start+i,src:imagePath(item.image)}));this.galleryTop=items.slice(0,2);this.galleryBottom=items.slice(2,4);this.galleryPageLabel=this._galleryCatalog.length+' 组 · '+this._galleryTotal+' 张 · 第 '+(this.galleryPage+1)+' / '+Math.ceil(this._galleryCatalog.length/4)+' 页';},
  previousGalleryPage(){if(this.loading||this.galleryPage===0)return;this.galleryPage--;this.refreshGallery();},
  nextGalleryPage(){if(this.loading||this.galleryPage>=Math.ceil(this._galleryCatalog.length/4)-1)return;this.galleryPage++;this.refreshGallery();},
  viewCg(index){if((this.mode!=='gallery'&&this.mode!=='cg')||this.loading||index<0||index>=this._galleryCatalog.length)return;this.cgIndex=index;this.cgVariant=0;this.mode='cg';this.renderCg();},
  renderCg(){const group=this._galleryCatalog[this.cgIndex],item=group.variants[this.cgVariant];this.cgSrc=imagePath(item.image);this.cgLabel=group.label+(group.variants.length>1?' · 差分 '+(this.cgVariant+1)+' / '+group.variants.length+' · 点击切换':'');console.log('STARRY_RW5 cg',this.cgIndex+1,this.cgVariant+1,item.image);},
  cycleCg(){if(this.mode!=='cg'||this.loading)return;const count=this._galleryCatalog[this.cgIndex].variants.length;if(count<2)return;this.cgVariant=stepVariant(this.cgVariant,1,count);this.renderCg();},
  previousCg(){if(this.mode==='cg'&&this.cgIndex>0)this.viewCg(this.cgIndex-1);},
  nextCg(){if(this.mode==='cg'&&this.cgIndex<this._galleryCatalog.length-1)this.viewCg(this.cgIndex+1);},
  backToGallery(){if(this.mode!=='cg')return;this.galleryPage=Math.floor(this.cgIndex/4);this.refreshGallery();this.mode='gallery';},
  refreshSettings(){this.autoLabel='自动播放：'+(this.autoEnabled?'开启':'关闭');this.autoSpeedLabel='自动速度：'+autoSpeeds[this.autoSpeed];this.speedLabel=this.textSpeed===0?'显示速度：即时':'显示速度：逐字';this.fontLabel=this.fontSize===28?'字号：大':'字号：标准';},
  persistSettings(){storage.set({complete:()=>{},key:'starry_rw5_settings_v1',value:JSON.stringify({fontSize:this.fontSize,textSpeed:this.textSpeed,autoSpeed:this.autoSpeed}),success:()=>{},fail:()=>{}});},
  toggleSpeed(){this.textSpeed=this.textSpeed===0?30:0;this.refreshSettings();this.persistSettings();},
  toggleFont(){this.fontSize=this.fontSize===24?28:24;this.refreshSettings();this.persistSettings();},
  toTitle(){if(this.storageBusy)return;this.stopAuto();this._touchReading=false;this._pendingFrame=false;this._chapterSkip=null;this.clearTyping();this.loadSequence++;this._slotsSequence++;this._gallerySequence++;this.loading=false;this.mode='title';this.backgroundSrc='/common/images/title_bg.png';this.bodySrc='';},
  toast(message){prompt.showToast({message,duration:1500,success:()=>{},fail:()=>{},complete:()=>{}});},
  fail(message){this.stopAuto();this._pendingFrame=false;this._chapterSkip=null;this.clearTyping();this.loading=false;this.mode='error';this.errorText=message;console.error('STARRY_RW5 error',message);}
}
</script>
